# Base de datos (PostgreSQL, esquema "finance")
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=savvi
# DB_SSL=false

# Firma de los JWT (obligatorio, mínimo 32 caracteres). Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=

# AWS S3 (adjuntos)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

PORT=4040

# Dominios del frontend que pueden llamar a la API y subir a S3 (separados por comas).
# Obligatorio en producción. En desarrollo, por defecto localhost:3000-3002.
CORS_ORIGINS=http://localhost:3001
# Solo si la API está detrás de un proxy (Nginx, Caddy): saltos a confiar para la IP real.
# TRUST_PROXY=1
# S3_MANAGE_CORS=false   # si el CORS del bucket se administra desde la infraestructura

# Email
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=

# Topes de Savvi IA por usuario (USD estimados) y peticiones por minuto
# AI_DAILY_LIMIT_USD=1
# AI_MONTHLY_LIMIT_USD=10
# AI_REQUESTS_PER_MINUTE=20

# Depuración (por defecto desactivado en producción)
# SWAGGER_ENABLED=true   # expone /docs aunque NODE_ENV=production
# DB_LOGGING=true        # registra todas las queries SQL
